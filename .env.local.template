# Environment Variables Template
# Copy this file to .env.local and fill in the values

# ============================================
# Firebase Client Configuration (Public)
# Get these from: Firebase Console → Project Settings → Your apps → Web app
# ============================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=universe-app-ab57a.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=universe-app-ab57a
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=universe-app-ab57a.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ============================================
# Firebase Admin SDK Configuration (Server-Only - SECRET)
# Get these from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Option 1: Service Account JSON (Recommended for Vercel)
# ============================================
# For local development - path to your service account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# For Vercel deployment - the JSON content as a string (escape newlines or base64 encode)
FIREBASE_SERVICE_ACCOUNT_KEY=

# OR individual fields from the service account JSON:
# FIREBASE_PROJECT_ID=universe-app-ab57a
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@universe-app-ab57a.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ============================================
# Algolia Search Configuration
# Get these from: Algolia Dashboard → API Keys
# ============================================
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=

# Admin key - SERVER ONLY, never expose in frontend
# Used by Server Actions to sync listings to Algolia
ALGOLIA_ADMIN_KEY=

# ============================================
# Session Configuration
# ============================================
# Secret for signing cookies (generate with: openssl rand -base64 32)
SESSION_SECRET=

# ============================================
# Supabase Storage Configuration
# Get these from: Supabase Dashboard → Settings → API
# ============================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# For admin scripts (cleanup, etc.) - get from Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# Environment
# ============================================
NODE_ENV=development
